# Run the e2e suite against a cluster that is already up (`make cluster`).
#
# Kept out of dev/tools/ci on purpose: the unit suite must stay runnable with
# no cluster, no Docker, and no network. This is a separate job.
#
# No -race: these tests shell out to kubectl and spend their time waiting on
# the cluster, so the instrumentation buys nothing and costs build time.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

kubeconfig="${SIMIAN_E2E_KUBECONFIG:-$(repo_root)/.kube/e2e.yaml}"
if [[ ! -f "$kubeconfig" ]]; then
  echo "ERROR: no e2e kubeconfig at $kubeconfig" >&2
  echo "       run 'make cluster' first" >&2
  exit 1
fi

exec go test -count=1 -tags e2e -timeout 20m -v ./test/... "$@"
