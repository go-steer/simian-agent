# Lint the Helm chart and assert that the safety-relevant values actually
# reach the controller's container args.
#
# A Helm value that renders to nothing is the worst kind of safety setting:
# the operator sets `permittedTiers: [namespace]` to keep node-level chaos off
# a cluster they care about, `helm install` succeeds, and the controller comes
# up with the default policy that still permits it. Nothing in the chart, the
# release, or the pod says otherwise. `helm lint` will not catch that — a
# template that silently drops a value is valid YAML.
#
# So the assertions below are on rendered args, and the negative cases carry as
# much weight as the positive ones.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

CHART=deploy/helm/simian

if ! command -v helm >/dev/null 2>&1; then
  # Deliberately not a skip. This check exists because the chart can be
  # broken in ways the Go tests cannot see; a silent pass on a machine
  # without helm is the same as not having the check.
  echo "verify-chart: helm not found on PATH — install it (https://helm.sh/docs/intro/install/)" >&2
  exit 1
fi

fail=0

# render <name> [helm-args...] — echoes the controller Deployment's rendered
# manifest for the given value overrides.
render() {
  local name="$1"; shift
  if ! helm template "$name" "$CHART" --set llm.vertex.project=verify-project "$@" 2>&1; then
    echo "verify-chart: helm template failed for case '$name'" >&2
    exit 1
  fi
}

# expect_arg <case> <rendered> <arg> — the arg must appear in the output.
expect_arg() {
  local case_name="$1" rendered="$2" arg="$3"
  if ! grep -qF -- "- $arg" <<<"$rendered"; then
    echo "✗ $case_name: expected container arg '$arg', not found" >&2
    fail=1
  fi
}

# reject_arg <case> <rendered> <arg> — the arg must NOT appear in the output.
reject_arg() {
  local case_name="$1" rendered="$2" arg="$3"
  if grep -qF -- "- $arg" <<<"$rendered"; then
    echo "✗ $case_name: container arg '$arg' should not be rendered, but was" >&2
    fail=1
  fi
}

echo "▸ helm lint"
helm lint "$CHART"

echo "▸ default values render both permitted tiers"
out="$(render sim-default)"
expect_arg "default" "$out" "--permitted-tiers=namespace"
expect_arg "default" "$out" "--permitted-tiers=node"
reject_arg "default" "$out" "--permitted-tiers=external"

echo "▸ narrowing to namespace drops the node tier"
# The reject is the assertion that matters. An operator who sets this has
# decided node-level chaos is not allowed here, and a template that appends
# rather than replaces would still render --permitted-tiers=node.
out="$(render sim-narrow --set-json 'executor.permittedTiers=["namespace"]')"
expect_arg "namespace-only" "$out" "--permitted-tiers=namespace"
reject_arg "namespace-only" "$out" "--permitted-tiers=node"

echo "▸ widening to external is possible but must be explicit"
out="$(render sim-wide --set-json 'executor.permittedTiers=["namespace","node","external"]')"
expect_arg "external" "$out" "--permitted-tiers=external"

echo "▸ an empty list renders no flag at all"
# Empty means "leave the built-in default alone", which the binary can only
# read from the flag's absence — see executor.ParsePermittedTiers. Rendering
# `--permitted-tiers=` here would be parsed as an unknown tier and stop the
# controller starting.
#
# --set-json, not --set: `--set executor.permittedTiers={}` is a one-element
# list holding the empty string, not an empty list, so it renders exactly the
# `--permitted-tiers=` this case is here to reject. That is a helm --set
# quirk rather than a chart bug, and the controller refuses to start on it
# rather than guessing — see helm-values.md.
out="$(render sim-empty --set-json 'executor.permittedTiers=[]')"
reject_arg "empty" "$out" "--permitted-tiers="

echo "▸ the baked-defaults overlay keeps node tier off"
# The overlay's header promises "everything experimental (Envoy injection,
# autonomous mode, node-tier chaos) is explicitly off". It sets
# permittedTiers: [namespace] to do it, so assert the promise, not the value.
out="$(render sim-baked -f examples/values-baked-defaults.yaml)"
expect_arg "baked-defaults" "$out" "--permitted-tiers=namespace"
reject_arg "baked-defaults" "$out" "--permitted-tiers=node"

echo "▸ the audit file is on by default, on a volume the controller can write"
# readOnlyRootFilesystem: an --audit-file with no volume under it fails at
# start-up, so the arg and the mount have to arrive together.
# On a PVC by default since chart 0.1.10: on an emptyDir the record of what
# Simian did is lost whenever the pod is rescheduled.
out="$(render sim-audit)"
expect_arg "audit-default" "$out" "--audit-file=/var/lib/simian/audit.jsonl"
if ! grep -qF "mountPath: /var/lib/simian" <<<"$out" || ! grep -qF "claimName: simian-audit" <<<"$out" || ! grep -qF "type: Recreate" <<<"$out"; then
  echo "✗ audit-default: expected the simian-audit claim mounted at /var/lib/simian and a Recreate strategy" >&2
  fail=1
fi
out="$(render sim-audit-off --set audit.file.enabled=false)"
reject_arg "audit-off" "$out" "--audit-file="
out="$(render sim-audit-emptydir --set audit.file.persistence.enabled=false)"
if ! grep -qF "mountPath: /var/lib/simian" <<<"$out" || ! grep -qF "emptyDir: {}" <<<"$out" || grep -qF "claimName: simian-audit" <<<"$out"; then
  echo "✗ audit-emptydir: expected an emptyDir mounted at /var/lib/simian and no claim" >&2
  fail=1
fi

echo "▸ the web UI is on by default (no flag, so a 0.2.x image still starts) and can be turned off"
reject_arg "ui-default" "$(render sim-ui)" "--ui=true"
reject_arg "ui-default" "$(render sim-ui)" "--ui=false"
expect_arg "ui-off" "$(render sim-ui-off --set ui.enabled=false)" "--ui=false"

echo "▸ metrics are served and scrapeable by default, and can be turned off"
out="$(render sim-metrics)"
expect_arg "metrics-default" "$out" "--metrics-addr=:9090"
if ! grep -qF "prometheus.io/scrape: \"true\"" <<<"$out" || ! grep -qF "name: metrics" <<<"$out"; then
  echo "✗ metrics-default: expected the scrape annotation and a metrics port" >&2
  fail=1
fi
out="$(render sim-metrics-off --set metrics.enabled=false)"
expect_arg "metrics-off" "$out" "--metrics-addr="
if grep -qF "prometheus.io/scrape" <<<"$out" || grep -qF "name: metrics" <<<"$out"; then
  echo "✗ metrics-off: still annotated or exposing a metrics port" >&2
  fail=1
fi
out="$(render sim-podmonitoring --set metrics.podMonitoring.enabled=true --set metrics.serviceMonitor.enabled=true)"
if ! grep -qF "kind: PodMonitoring" <<<"$out" || ! grep -qF "kind: ServiceMonitor" <<<"$out"; then
  echo "✗ metrics-monitors: expected a PodMonitoring and a ServiceMonitor" >&2
  fail=1
fi

echo "▸ an install that names no Vertex project refuses to render"
# The chart used to default to the development project, so an install that
# forgot the flag sent its LLM calls there.
if helm template sim-noproject "$CHART" >/dev/null 2>&1; then
  echo "✗ vertex-project: rendered with llm.vertex.enabled and no llm.vertex.project" >&2
  fail=1
fi
if ! helm template sim-apikey "$CHART" --set llm.vertex.enabled=false --set llm.apiKey.enabled=true >/dev/null 2>&1; then
  echo "✗ vertex-project: the API-key path should not need a Vertex project" >&2
  fail=1
fi

echo "▸ the baked-defaults overlay pins the image the chart is written for"
# The chart renders the controller's flags; an image older than the chart
# exits on the first one it does not know. The overlay pinned 0.1.3-dev for
# months while the chart grew --audit-file, so an install that followed the
# recommended path got a controller that never started.
app_version="$(sed -n 's/^appVersion: *"\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$CHART/Chart.yaml")"
pinned="$(sed -n 's/^  tag: *"\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' examples/values-baked-defaults.yaml | head -1)"
if [[ -z "$pinned" || "$pinned" != "$app_version" ]]; then
  echo "✗ baked-defaults: image.tag is '$pinned', chart appVersion is '$app_version' — bump the pin with the chart" >&2
  fail=1
fi

if [[ "$fail" -ne 0 ]]; then
  echo >&2
  echo "✗ chart assertions failed" >&2
  exit 1
fi

echo "✓ chart renders the executor safety policy into the container args"
