# Score a pack against k8s-sre-agent on a cluster that is already up.
#
# The counterpart to eval-lookout, and the reason that one exists first. This
# subject is an LLM agent: its score moves for the fault, for the agent, and
# for sampling noise, and only the deterministic detector's row can tell those
# apart. Read the two rows together or neither means much.
#
#   dev/tools/eval-sre-agent --only lookout-crash-loop
#   SIMIAN_EVAL_PACK=parity dev/tools/eval-sre-agent --subject-timeout 4m
#
# Extra arguments are passed through to simian-eval, and a repeated flag takes
# its last value, so every default below can be overridden on the command line
# — with one exception. `--pack` is genuinely repeatable: passing it a second
# time runs both packs as one suite, which for these two packs is a load error
# about duplicate scenario names rather than anything useful. Set SIMIAN_EVAL_PACK
# to choose a different one.
#
# # This one costs money
#
# Unlike every other tool in here, a run spends real model tokens. Nine
# scenarios is nine independent agent sessions, each of which delegates across
# a specialist roster. Start with --only.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

# The agent is built from a checkout rather than the module proxy, because it
# is the thing under test here and the interesting version is usually the one
# on somebody's disk. Point SIMIAN_SRE_AGENT_BIN at a build to skip this.
# The repository is go-steer/k8s-sre-agent. It was called core-sre-agent for
# one day in August 2026 and renamed on the same day, but checkouts made under
# the old directory name outlive the rename, so both are tried before giving up.
agent_src="${SIMIAN_SRE_AGENT_SRC:-}"
if [[ -z "$agent_src" ]]; then
  for candidate in "$HOME/projects/k8s-sre-agent" "$HOME/projects/core-sre-agent"; do
    if [[ -d "$candidate" ]]; then
      agent_src="$candidate"
      break
    fi
  done
  agent_src="${agent_src:-$HOME/projects/k8s-sre-agent}"
fi
agent="${SIMIAN_SRE_AGENT_BIN:-}"
if [[ -z "$agent" ]]; then
  if [[ ! -d "$agent_src" ]]; then
    echo "ERROR: no k8s-sre-agent checkout at $agent_src" >&2
    echo "       set SIMIAN_SRE_AGENT_SRC, or SIMIAN_SRE_AGENT_BIN to a build" >&2
    exit 1
  fi
  agent="$PWD/bin/sre-agent"
  echo "▸ building sre-agent from $agent_src" >&2
  mkdir -p "$(dirname "$agent")"
  (cd "$agent_src" && go build -o "$agent" ./cmd/sre-agent)
fi

# The agent's own lookout, which is *not* the one eval-lookout grades.
#
# It reaches lookout over MCP as a tool, and k8s-sre-agent pins a much later
# release than Simian's baseline row does. Both pins are deliberate and they
# are answering different questions: Simian's is "what does the detector score",
# and must not float; the agent's is "what tools does the agent have", and is
# the agent repo's call. Do not unify them — an agent graded against a detector
# it does not use would be a comparison of two different things.
lookout_version="${SIMIAN_SRE_AGENT_LOOKOUT_VERSION:-v0.20.0}"
lookout="${SRE_LOOKOUT_BIN:-$PWD/bin/lookout-$lookout_version}"
if [[ ! -x "$lookout" ]]; then
  echo "▸ building k8s-lookout $lookout_version (the agent's tool)" >&2
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  GOBIN="$tmp" go install "github.com/go-steer/k8s-lookout/cmd/lookout@$lookout_version"
  mkdir -p "$(dirname "$lookout")"
  mv "$tmp/lookout" "$lookout"
fi

kubeconfig="${SIMIAN_E2E_KUBECONFIG:-$PWD/.kube/e2e.yaml}"
if [[ ! -f "$kubeconfig" ]]; then
  echo "ERROR: no e2e kubeconfig at $kubeconfig" >&2
  echo "       run 'make cluster' first, or set SIMIAN_E2E_KUBECONFIG" >&2
  exit 1
fi

# The agent refuses to guess at a context and refuses a kubeconfig describing
# more than one, so the pin is read from the file rather than passed in. A
# kubeconfig describing one cluster cannot reach a second one, which is the
# property that makes an unattended run on a shared cluster tolerable.
kubecontext="$(kubectl --kubeconfig "$kubeconfig" config current-context)"

# Provider credentials. The agent needs a Vertex project and location; nothing
# in this repo knows what they are, and a run that discovers that eight minutes
# in has already spent a scenario's lease.
: "${GOOGLE_CLOUD_PROJECT:?set GOOGLE_CLOUD_PROJECT (e.g. . ~/scripts/gemini.sh)}"
: "${GOOGLE_CLOUD_LOCATION:?set GOOGLE_CLOUD_LOCATION (e.g. . ~/scripts/gemini.sh)}"

out="${SIMIAN_EVAL_OUT:-runs/sre-agent-$(date -u +%Y%m%d-%H%M%S)}"
mkdir -p "$out"

# Where the agent's lookout runs, and so where its network probes come from.
#
# lookout probes from wherever its process is, by design: it never spawns a pod
# to probe from, and says to run it in-cluster when that view is wanted. Run on
# this workstation, every probe of a Service name or ClusterIP fails even when
# the Service is healthy, and nothing in the output says why. On the dataplane
# pack the agent took those failures as evidence for causes it made up.
#
# in-cluster (the default) runs lookout in a pod, the vantage a deployed agent
# has: the agent still spawns "lookout mcp", but SRE_LOOKOUT_BIN is a wrapper
# that runs it there with kubectl exec. The pod reads the cluster as its own
# ServiceAccount: the built-in view role plus secrets and the cluster-scoped
# objects lookout checks, and nothing from chaos-mesh.org. workstation keeps the old behaviour, for comparing
# against runs made before this existed.
vantage="${SIMIAN_SRE_AGENT_VANTAGE:-in-cluster}"
case "$vantage" in
  in-cluster)
    vantage_ns=simian-vantage
    static="$PWD/bin/lookout-$lookout_version-static"
    if [[ ! -x "$static" ]]; then
      # Static, because the pod's image is busybox and has no libc to link
      # against; the workstation build above is cgo.
      echo "▸ building a static k8s-lookout $lookout_version for the vantage pod" >&2
      tmp_static="$(mktemp -d)"
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOBIN="$tmp_static" \
        go install "github.com/go-steer/k8s-lookout/cmd/lookout@$lookout_version"
      mv "$tmp_static/lookout" "$static"
      rm -rf "$tmp_static"
    fi
    echo "▸ starting the in-cluster vantage pod ($vantage_ns/lookout)" >&2
    kubectl --kubeconfig "$kubeconfig" apply -f - >/dev/null <<YAML
apiVersion: v1
kind: Namespace
metadata:
  name: $vantage_ns
  labels: {app.kubernetes.io/part-of: simian-eval}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: lookout, namespace: $vantage_ns}
---
# What lookout reads beyond the built-in view role: the cluster-scoped
# objects its health, storage, webhook and scheduling checks look at. Not a
# wildcard, and never chaos-mesh.org (#129): the agent under test must read
# the cluster without being able to read the answer, and Chaos Mesh's
# per-pod objects in the arena spell the fault out while it runs.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: simian-vantage-lookout
  labels: {app.kubernetes.io/part-of: simian-eval}
rules:
- apiGroups: [""]
  resources: [nodes, persistentvolumes, componentstatuses]
  verbs: [get, list, watch]
# view leaves out secrets, and lookout's health, edges, events and radius
# checks fail outright without them (key references, TLS expiry) rather than
# skipping what they cannot read.
- apiGroups: [""]
  resources: [secrets]
  verbs: [get, list, watch]
- apiGroups: [storage.k8s.io]
  resources: [storageclasses, csidrivers, csinodes, volumeattachments]
  verbs: [get, list, watch]
- apiGroups: [admissionregistration.k8s.io]
  resources: [mutatingwebhookconfigurations, validatingwebhookconfigurations, validatingadmissionpolicies, validatingadmissionpolicybindings]
  verbs: [get, list, watch]
# view leaves out RBAC objects too; edges, events and radius follow
# ServiceAccount → RoleBinding references.
- apiGroups: [rbac.authorization.k8s.io]
  resources: [roles, rolebindings, clusterroles, clusterrolebindings]
  verbs: [get, list, watch]
- apiGroups: [apiextensions.k8s.io]
  resources: [customresourcedefinitions]
  verbs: [get, list, watch]
- apiGroups: [apiregistration.k8s.io]
  resources: [apiservices]
  verbs: [get, list, watch]
- apiGroups: [scheduling.k8s.io]
  resources: [priorityclasses]
  verbs: [get, list, watch]
- apiGroups: [node.k8s.io]
  resources: [runtimeclasses]
  verbs: [get, list, watch]
- apiGroups: [networking.k8s.io]
  resources: [ingressclasses]
  verbs: [get, list, watch]
- apiGroups: [coordination.k8s.io]
  resources: [leases]
  verbs: [get, list, watch]
- apiGroups: [events.k8s.io]
  resources: [events]
  verbs: [get, list, watch]
- apiGroups: [certificates.k8s.io]
  resources: [certificatesigningrequests]
  verbs: [get, list, watch]
- apiGroups: [metrics.k8s.io]
  resources: [pods, nodes]
  verbs: [get, list]
- nonResourceURLs: [/healthz, /healthz/*, /livez, /livez/*, /readyz, /readyz/*, /version]
  verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: simian-vantage-lookout
  labels: {app.kubernetes.io/part-of: simian-eval}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: simian-vantage-lookout}
subjects:
- {kind: ServiceAccount, name: lookout, namespace: $vantage_ns}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: simian-vantage-lookout-view
  labels: {app.kubernetes.io/part-of: simian-eval}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: view}
subjects:
- {kind: ServiceAccount, name: lookout, namespace: $vantage_ns}
---
apiVersion: v1
kind: Pod
metadata:
  name: lookout
  namespace: $vantage_ns
  labels: {app.kubernetes.io/part-of: simian-eval}
spec:
  serviceAccountName: lookout
  terminationGracePeriodSeconds: 1
  securityContext: {runAsNonRoot: true, runAsUser: 65534, runAsGroup: 65534}
  containers:
  - name: lookout
    image: busybox:1.36
    command: [sleep, infinity]
    securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
YAML
    kubectl --kubeconfig "$kubeconfig" -n "$vantage_ns" wait --for=condition=Ready pod/lookout --timeout=180s >/dev/null
    kubectl --kubeconfig "$kubeconfig" -n "$vantage_ns" cp "$static" lookout:/tmp/lookout
    kubectl --kubeconfig "$kubeconfig" -n "$vantage_ns" exec lookout -- chmod 0755 /tmp/lookout

    # The agent starts lookout from an empty environment plus KUBECONFIG, so
    # the wrapper names everything else it needs: PATH and HOME for kubectl's
    # GKE auth plugin. It uses the KUBECONFIG the agent hands it, which is
    # the one the agent verified, so the agent's one-cluster pin holds.
    #
    # kubectl's stderr goes to a file, not to the agent's. kubectl exec can
    # outlive the agent by a few seconds while its websocket closes, and
    # holding the agent's stderr — the harness's pipe — that long made the
    # harness give up on a subject that had already written its report.
    lookout="$PWD/$out/lookout-in-cluster"
    cat > "$lookout" <<WRAPPER
#!/bin/bash
export PATH="$PATH" HOME="$HOME"
exec "$(command -v kubectl)" -n $vantage_ns exec -i lookout -- /tmp/lookout "\$@" 2>>"$PWD/$out/lookout-in-cluster.log"
WRAPPER
    chmod 0755 "$lookout"
    ;;
  workstation) ;;
  *)
    echo "ERROR: SIMIAN_SRE_AGENT_VANTAGE must be in-cluster or workstation, not $vantage" >&2
    exit 1
    ;;
esac

echo "▸ k8s-sre-agent → $out (agent: $agent, its lookout: $lookout, vantage: $vantage)" >&2

# --subject-timeout 12m: the agent's own default is 8 minutes per namespace and
#   the adapter takes a margin off whatever it is given, so this leaves the
#   agent its full default with room to write a transcript. It is longer than
#   several leases in the lookout pack, which the harness refuses outright
#   rather than let a lease expire mid-investigation and record it as the agent
#   having remediated the fault. Raise the pack's durations, not this.
#
# --concurrency 1: the default fans out, and nine agent sessions against one
#   Vertex project is how a run discovers a quota it did not know it had.
#
# --min-efficacy 1: same assertion as eval-lookout. Every fault must land. The
#   agent's own numbers are measurements and are never gated — a score that
#   moved is the whole output.
exec go run ./cmd/simian-eval \
  --pack "${SIMIAN_EVAL_PACK:-lookout}" \
  --subject "sre-agent:$agent -kubeconfig $kubeconfig -context $kubecontext" \
  --kubeconfig "$kubeconfig" \
  --subject-env "KUBECONFIG=$kubeconfig" \
  --subject-env "SRE_LOOKOUT_BIN=$lookout" \
  --subject-env "GOOGLE_CLOUD_PROJECT=$GOOGLE_CLOUD_PROJECT" \
  --subject-env "GOOGLE_CLOUD_LOCATION=$GOOGLE_CLOUD_LOCATION" \
  --subject-env "GOOGLE_GENAI_USE_VERTEXAI=${GOOGLE_GENAI_USE_VERTEXAI:-true}" \
  --subject-timeout 12m \
  --concurrency 1 \
  --min-efficacy 1 \
  --out "$out" \
  "$@"
