# Let the in-cluster controller call Vertex AI through GKE Workload Identity.
#
# Binds roles/aiplatform.user directly to the controller's Kubernetes
# ServiceAccount (no Google service account, no KSA annotation needed). The
# cluster must have Workload Identity enabled (pool <project>.svc.id.goog).
#
# Usage:
#   dev/tools/grant-vertex-access [--revoke]
#
# Env (defaults match deploy/helm/simian/values.yaml):
#   GOOGLE_CLOUD_PROJECT   project hosting Vertex AI and the cluster (gke-demos-345619)
#   SIMIAN_NAMESPACE       controller namespace                     (simian-system)
#   SIMIAN_KSA             controller ServiceAccount                (simian-controller)
#
# The binding is project-wide and outlives the cluster: run with --revoke
# when the cluster is deleted.
set -euo pipefail

project="${GOOGLE_CLOUD_PROJECT:?set GOOGLE_CLOUD_PROJECT to the project that runs the cluster}"
namespace="${SIMIAN_NAMESPACE:-simian-system}"
ksa="${SIMIAN_KSA:-simian-controller}"
role="roles/aiplatform.user"

action="add-iam-policy-binding"
if [[ "${1:-}" == "--revoke" ]]; then
  action="remove-iam-policy-binding"
elif [[ $# -gt 0 ]]; then
  echo "usage: $0 [--revoke]" >&2
  exit 2
fi

number="$(gcloud projects describe "$project" --format='value(projectNumber)')"
member="principal://iam.googleapis.com/projects/${number}/locations/global/workloadIdentityPools/${project}.svc.id.goog/subject/ns/${namespace}/sa/${ksa}"

echo "${action}: ${role} -> ${member}"
gcloud projects "$action" "$project" \
  --member="$member" \
  --role="$role" \
  --condition=None \
  --format=none
echo "done. IAM changes can take a minute or two to take effect."
