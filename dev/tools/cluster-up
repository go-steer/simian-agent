# Stand up the local e2e cluster: kind + Calico + Chaos Mesh.
#
# The work happens in internal/kindcluster so that this script, the e2e
# workflow, and the Go test harness all drive one implementation. See
# dev/kind/cluster.yaml for the CNI decision.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

for tool in kind kubectl helm docker; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "ERROR: $tool not found on PATH" >&2
    exit 1
  }
done

exec go run ./internal/kindcluster/kindctl up "$@"
